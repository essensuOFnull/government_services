VITE_API_URL=http://localhost:3001/api
DB_PATH=C:/government_services/DB

# -----------------------------
# Messenger / Storage settings
# -----------------------------
PORT=22869
NODE_ENV=development
FRONTEND_URL=http://localhost:22869

# Путь к файлу БД мессенджера (SQLite)
DATABASE_PATH=C:/government_services/app.db

# Папки для хранения сгенерированных сервером данных
UPLOAD_DIR=C:/government_services/uploads
S3_DATA_DIR=C:/government_services/s3
LOG_DIR=C:/government_services/logs

# S3 / объектное хранилище (если потребуется внешний S3)
S3_ENDPOINT=http://localhost:4569
S3_BUCKET=messenger-files
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=S3RVER
AWS_SECRET_ACCESS_KEY=S3RVER

# Лимиты
MIN_SERVER_FREE_SPACE=10737418240
GUEST_STORAGE_LIMIT=10737418240
FILE_CLEANUP_DAYS=30
CLEANUP_SCHEDULE=0 2 * * *

# WebSocket
WS_PATH=/ws/messenger
WS_HEARTBEAT_INTERVAL=30000
WS_IDLE_TIMEOUT=300000

# Загрузка файлов
MAX_FILE_SIZE=0

# MIME-типы (comma-separated)
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,image/svg+xml,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,text/csv,application/json,application/zip,application/x-rar-compressed,application/x-7z-compressed,audio/mpeg,audio/wav,audio/ogg,video/mp4,video/mpeg,video/quicktime,video/x-msvideo,video/webm

# Логирование
LOG_LEVEL=info
LOG_FILE=C:/government_services/logs/messenger.log

# Кэширование
CACHE_ENABLED=true
CACHE_TTL=3600

USE_HTTPS=true